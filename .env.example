# ---- Claude ----
# API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5).
# CLAUDE_MODEL=

# ---- Supabase (Project Settings → API, and Project Settings → Database) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The pooled connection string ("Transaction" mode, port 6543), with your database password filled in.
DATABASE_URL=

# ---- Access ----
# Codes members enter after signing up, comma-separated. Put one in your Stan Store delivery email.
MEMBER_ACCESS_CODES=
# Codes that unlock the Performance Pack (and membership).
PERFORMANCE_ACCESS_CODES=
# Your email(s): full access plus the Admin dashboard.
ADMIN_EMAILS=
# Any long random string.
ACCESS_SECRET=
