# Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Comma-separated access codes you give to paying members (e.g. in the Stan Store delivery email).
# With none set, the app is open in `npm run dev` and locked in production.
MEMBER_ACCESS_CODES=

# Any long random string. Used to sign the login cookie. Changing it logs everyone out.
ACCESS_SECRET=

# Optional: override the model (default claude-opus-5).
# CLAUDE_MODEL=
