{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Higgsfield__generate_video",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-higgsfield-params.py\"",
            "timeout": 10,
            "statusMessage": "Checking Higgsfield params against the lock card..."
          }
        ]
      }
    ]
  }
}
